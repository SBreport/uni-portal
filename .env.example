# ============================================================
# uni-portal 환경변수 설정 (.env.example)
# 이 파일을 .env로 복사한 후 값을 수정하세요
# Portainer에서는 Stack > Environment variables에 직접 입력 가능
# 주의: 이 파일에는 실제 값을 절대 넣지 마세요 (public repo)
# ============================================================

# 인증 salt — 비밀번호 해싱 전용. 반드시 무작위 긴 값으로 설정.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
# (변경 시 기존 비밀번호 해시가 무효화됨 → 아래 AUTH_SALT_LEGACY 참고)
AUTH_SALT=

# JWT 서명키 — salt와 분리(노출 시 토큰 위조 방지). 반드시 별도 무작위 값으로 설정.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# (선택, 전환기용) 옛 salt로 저장된 비밀번호를 락아웃 없이 인정. salt 교체 시에만 잠시 설정.
# 모든 사용자가 새 비번으로 갈아탄 뒤 반드시 제거할 것.
# AUTH_SALT_LEGACY=

# 최초 관리자 계정 (DB에 사용자가 없을 때만 사용)
# PW_HASH 생성: python -c "import hashlib,os; s=os.environ['AUTH_SALT']; print(hashlib.sha256((s+'원하는비번').encode()).hexdigest())"
AUTH_BOOTSTRAP_ADMIN_ID=admin
AUTH_BOOTSTRAP_ADMIN_PW_HASH=
AUTH_BOOTSTRAP_ADMIN_ROLE=admin

# CORS 허용 도메인 (콤마 구분, 미지정 시 localhost 기본)
# 운영 배포 시 실제 도메인으로 설정
# ALLOWED_ORIGINS=https://portal.example.com,https://admin.example.com

# Google Sheets 이벤트 시트 ID (선택사항)
EVENT_SHEET_ID=

# Notion 연동 (선택사항) — 토큰은 절대 커밋 금지
NOTION_TOKEN=
NOTION_BLOG_DB_ID=
